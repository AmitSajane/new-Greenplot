# ─── GreenPlot environment template ──────────────────────────────────────
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# After editing .env, restart Metro:  yarn start --reset-cache

# Mapbox access token (https://account.mapbox.com/access-tokens/)
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# Geocoding (https://geocode.maps.co/)
GEOCODE_API_KEY=your_geocode_api_key_here
GEOCODE_BASE_URL=https://geocode.maps.co

# Soil data API base URL
SOIL_API_BASE_URL=https://www.kaegro.com/farms/api/soil

# Supabase (https://app.supabase.com → your project → Settings → API)
SUPABASE_URL=https://rjmfqcrqnnfgcahrzsle.supabase.co
